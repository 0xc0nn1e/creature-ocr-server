# Copy to .env and fill in. .env is git-ignored and is never copied into the
# image; compose reads it on the host at start-up. Every value here is empty on
# purpose - a template that ships a working project id is a template that
# eventually bills somebody who never chose it.

# ---------------------------------------------------------------------------
# Google, for the gemini engine
# ---------------------------------------------------------------------------

# HOW THIS SERVER AUTHENTICATES.
#
# The intended way is Application Default Credentials, logged in ON THE HOST:
#
#     gcloud auth application-default login
#     gcloud auth application-default set-quota-project <project>
#
# That login needs a browser and writes into the host's own gcloud
# configuration, so it is never run inside the container: there is nothing in
# there to open a browser with, and anything it wrote would disappear with the
# container.
#
# Then tell compose where that configuration lives. Forward slashes, even on
# Windows:
#
#     Windows        C:/Users/<you>/AppData/Roaming/gcloud
#     macOS, Linux   /home/<you>/.config/gcloud
#
# compose mounts it read-only at /gcloud and sets CLOUDSDK_CONFIG to match, so
# the container reads the host's credentials and writes nothing of its own.
# Leave it empty when running with `python -m creature_ocr_server`: the SDK
# finds the same files by itself. Left empty under compose it falls back to
# secrets/, which holds no credentials - which is what the service account
# route below wants. (6.3)
GCLOUD_CONFIG_DIR=

# A user login carries no quota project unless `set-quota-project` above was
# run against it. Filling this in is the other way to say the same thing;
# google-auth reads it directly. A service account bills its own project and
# needs neither.
GOOGLE_CLOUD_QUOTA_PROJECT=

# The other way to authenticate: as a service account rather than as whoever
# last logged in at this machine, which is what an unattended or shared
# deployment wants. Leave EMPTY to use the ADC above. Two forms are accepted:
#
#   GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/ocr-runner.json
#   GOOGLE_APPLICATION_CREDENTIALS={"type": "service_account", "project_id": ...}
#
# The first is Google's own meaning for this variable and is the one to use in
# a container: put the key file in secrets/, which compose mounts read-only at
# /run/secrets, so rotating it is a restart rather than a rebuild and the key
# never enters a layer. The second form puts a PRIVATE KEY in this file - it
# works, but do not put this file in a screenshot, a chat or an issue.
#
# Give the service account the least it needs, roles/aiplatform.user on the
# project. Without it every page comes back 403 PERMISSION_DENIED, which reads
# like a broken deployment rather than a missing role. (6.3)
#
# A value that is set but unusable stops the request. It is never quietly
# ignored, because falling back to ADC would read the batch as somebody else
# and bill them.
GOOGLE_APPLICATION_CREDENTIALS=

# The Google Cloud project the model is served from. Project id or number.
GOOGLE_CLOUD_PROJECT=

# The Vertex AI region, e.g. us-central1, asia-northeast1, or global. `global`
# is valid and is where the newer Gemini models are usually served from. A
# wrong value makes every call fail in a way that reads like a broken project.
GEMINI_LOCATION=

# The model a request that names none is served with, e.g. gemini-3.7-flash.
# There is deliberately no default: Vertex model ids are versioned and retired
# on Google's own schedule, so a default baked into the code would eventually
# either fail every call or, worse, quietly read every page with a model nobody
# chose. Look them up in the Vertex AI model garden or with
#   gcloud ai models list
GEMINI_MODEL=

# Which models a request is allowed to ask for, comma separated. Leave it empty
# to use the list in config.py. It is an allow-list rather than a menu: an
# engine is built once per model and kept, so a free-form model string would
# grow this server an SDK client per request.
GEMINI_MODELS=

# Which engine reads a page when the request does not say. Only `gemini` exists
# so far; leave it empty for the default.
OCR_ENGINE=

# ---------------------------------------------------------------------------
# The server itself. Every one of these has a working default.
# ---------------------------------------------------------------------------

# Leave it empty and this server answers anyone who can reach it, which is fine
# behind a firewall on a machine you own and is otherwise a way to give your
# Vertex quota away. Set it and every request must carry an X-API-Key header
# with this value. It is logged nowhere and never appears in a response.
SERVER_API_KEY=

# The largest page this server accepts, in bytes. Default 20971520 (20 MiB); a
# 300 DPI page of this sheet is around half a megabyte, so the cap is there to
# refuse a body nobody meant to send.
SERVER_MAX_IMAGE_BYTES=

# How many engine calls may be in flight at once. Default 4, which sits in the
# middle of the 2 to 8 the requirements ask for. The binding constraint is the
# Vertex quota rather than this machine, so raising it costs nothing here and
# may cost everything there. (6.1)
SERVER_MAX_CONCURRENCY=

# The whole budget for one page, in seconds. Default 300. A page measures 18 to
# 68 seconds and three retries add 1 + 2 + 4 seconds of backoff, so a genuinely
# bad page can legitimately take about 280. EVERY client and every proxy in
# front of this server needs a read timeout larger than this - a default nginx
# allows 60 seconds and would cut a perfectly healthy slow page in three.
SERVER_REQUEST_DEADLINE_SECONDS=

# How long a request waits for a free slot before it is turned away with 429
# and a Retry-After. Default 30.
SERVER_QUEUE_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Only for `python -m creature_ocr_server`. The container passes its own.
# ---------------------------------------------------------------------------

# Default 127.0.0.1 and 8000. The container binds 0.0.0.0 inside itself and
# compose publishes it on the loopback address of the host.
HOST=
PORT=

# debug, info, warning, error. Default info.
LOG_LEVEL=
